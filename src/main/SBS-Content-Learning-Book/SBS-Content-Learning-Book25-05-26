package com.shreebenakaspace.content.service;

import com.shreebenakaspace.content.dto.ContentDTO;
import com.shreebenakaspace.content.entity.Content;
import com.shreebenakaspace.content.exception.ResourceNotFoundException;
import com.shreebenakaspace.content.repository.ContentRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;

@Service
public class ContentService {

    @Autowired
    private ContentRepository contentRepository;

    // CREATE
    public Content createContent(ContentDTO dto) {

        Content content = new Content();

        content.setTitle(dto.getTitle());
        content.setDescription(dto.getDescription());
        content.setUserId(dto.getUserId());

        return contentRepository.save(content);
    }

    // GET ALL
    public List<Content> getAllContents() {

        return contentRepository.findAll();
    }

    // GET BY ID
    public Content getContentById(Long id) {

        return contentRepository.findById(id)
                .orElseThrow(() ->
                        new ResourceNotFoundException(
                                "Content not found with id: " + id));
    }

    // UPDATE
    public Content updateContent(Long id, ContentDTO dto) {

        Content existingContent = contentRepository.findById(id)
                .orElseThrow(() ->
                        new ResourceNotFoundException(
                                "Content not found with id: " + id));

        existingContent.setTitle(dto.getTitle());
        existingContent.setDescription(dto.getDescription());
        existingContent.setUserId(dto.getUserId());

        return contentRepository.save(existingContent);
    }

    // DELETE
    public String deleteContent(Long id) {

        Content existingContent = contentRepository.findById(id)
                .orElseThrow(() ->
                        new ResourceNotFoundException(
                                "Content not found with id: " + id));

        contentRepository.delete(existingContent);

        return "Content deleted successfully";
    }
}
